# Build outputs (see makefile: `make build`, `make clean`)
/bin/
/obj/

# Simulation output (see makefile OUTDIR / each engine's default: CSVs into
# data/, sample walker paths into visualization/path_visual/path_*.txt,
# shell/boundary point dumps into visualization/shell_visual/*_shell.txt,
# other point dumps into visualization/*.txt directly). These patterns only
# match generated dumps, not the path_visualizer.py / shell_visualizer.py
# scripts that live in those same two folders.
/data/*
!/data/.gitkeep
/visualization/*.txt
/visualization/path_visual/path_*.txt
/visualization/shell_visual/*_shell.txt

# Custom --outdir overrides some users may pass on the command line
results_2d/
results_3d/
results_2d_hull/
results_3d_hull/

# Python cruft (visualization/ scripts)
__pycache__/
*.pyc

# Editor/OS cruft
.vscode/
.DS_Store
