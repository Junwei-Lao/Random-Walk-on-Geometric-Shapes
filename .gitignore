# Build outputs (see makefile: `make build`, `make clean`)
/bin/
/obj/

# Simulation output: every engine and mask tool saves everything (CSVs,
# sample walker paths, mask/point dumps) under one directory, defaulting to
# data/ at the repo root (see makefile OUTDIR / each binary's --outdir).
!/data/.gitkeep

# Custom --outdir overrides some users may pass on the command line
results_2d/
results_3d/
results_2d_hull/
results_3d_hull/

# Python cruft (visualization/ scripts)
__pycache__/
*.pyc

# Editor/OS cruft
.vscode/
.DS_Store
venv